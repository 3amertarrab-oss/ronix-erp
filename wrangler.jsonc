{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crm-ronix",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./erp/site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm-ronix",
      "database_id": "448a8be9-0969-4431-b72c-c1c21eaadae5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "crm-ronix-files"
    }
  ],
  "observability": { "enabled": true }
}
