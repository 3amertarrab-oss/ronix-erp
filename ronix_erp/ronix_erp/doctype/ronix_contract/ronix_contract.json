    "items_section", "items", "schedule_section", "payment_schedule",
    "scope_section", "scope", "terms", "approval_section", "technical_approved", "finance_approved", "management_approved", "signed_by_customer", "signed_by_company", "amended_from"
  ],
  "fields": [
