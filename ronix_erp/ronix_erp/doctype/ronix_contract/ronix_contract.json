    {"fieldname": "quotation", "fieldtype": "Link", "label": "Quotation", "options": "Quotation", "reqd": 1, "unique": 1},
    {"fieldname": "project", "fieldtype": "Link", "label": "Project", "options": "Project", "read_only": 1, "no_copy": 1, "allow_on_submit": 1},
    {"fieldname": "commercial_section", "fieldtype": "Section Break", "label": "Commercial Details"},
    {"fieldname": "contract_date", "fieldtype": "Date", "label": "Contract Date", "reqd": 1},
    {"fieldname": "start_date", "fieldtype": "Date", "label": "Start Date"},
    {"fieldname": "end_date", "fieldtype": "Date", "label": "End Date"},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "reqd": 1},
    {"fieldname": "exchange_rate", "fieldtype": "Float", "label": "Exchange Rate", "default": "1", "reqd": 1},
    {"fieldname": "contract_value", "fieldtype": "Currency", "label": "Contract Value", "read_only": 1, "options": "currency", "in_list_view": 1},
    {"fieldname": "items_section", "fieldtype": "Section Break", "label": "Contract Items"},
    {"fieldname": "items", "fieldtype": "Table", "label": "Items", "options": "RONIX Contract Item", "reqd": 1},
    {"fieldname": "schedule_section", "fieldtype": "Section Break", "label": "Payment Schedule"},
    {"fieldname": "payment_schedule", "fieldtype": "Table", "label": "Payment Schedule", "options": "RONIX Contract Milestone"},
    {"fieldname": "scope_section", "fieldtype": "Section Break", "label": "Scope and Terms"},
    {"fieldname": "scope", "fieldtype": "Text Editor", "label": "Scope of Work", "reqd": 1},
    {"fieldname": "terms", "fieldtype": "Text Editor", "label": "Terms and Conditions"},
    {"fieldname": "approval_section", "fieldtype": "Section Break", "label": "Approval Gates"},
    {"fieldname": "technical_approved", "fieldtype": "Check", "label": "Technical Approved", "default": "0"},
    {"fieldname": "finance_approved", "fieldtype": "Check", "label": "Finance Approved", "default": "0"},
    {"fieldname": "management_approved", "fieldtype": "Check", "label": "Management Approved", "default": "0"},
    {"fieldname": "signed_by_customer", "fieldtype": "Data", "label": "Signed by Customer"},
    {"fieldname": "signed_by_company", "fieldtype": "Data", "label": "Signed by Company"},
    {"fieldname": "amended_from", "fieldtype": "Link", "label": "Amended From", "options": "RONIX Contract", "read_only": 1, "no_copy": 1, "print_hide": 1}
