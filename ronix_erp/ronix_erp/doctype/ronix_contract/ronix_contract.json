    {"fieldname": "contract_status", "fieldtype": "Select", "label": "Contract Status", "options": "Draft\nInternal Review\nApproved\nSigned\nActive\nClosed\nCancelled", "default": "Draft", "reqd": 1, "in_list_view": 1, "allow_on_submit": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company", "reqd": 1},
